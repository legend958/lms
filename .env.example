# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# App
APP_ENV=development
APP_NAME=LMS
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api

# Database
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms

# Redis (optional for single-node development; required for workers)
REDIS_URL=redis://localhost:6379/0
# auto = ARQ when REDIS_URL is set, otherwise in-process; disabled in tests
INGEST_QUEUE=auto

# Auth
SESSION_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
SEED_ADMIN_PASSWORD=ChangeMe123!
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_HOUR=10

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Vector store (Phase 2+)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=lms_chunks
CHROMA_TOP_K=12
CHROMA_FINAL_K=6
CHROMA_MIN_SIMILARITY=0.30

# Embeddings (Phase 2+)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
# Local model cache. Docker overrides this with /models (baked into the image).
HF_HOME=./data/models

# LLM (Phase 3+)
# Optional in development: without a key, topic extraction falls back to headings.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
GROQ_TOPIC_MAX_TOKENS=4096
GROQ_TOPIC_BATCH_TOKENS=6000
GROQ_TOPIC_RETRIES=2
# Groq's free tier is 8k tokens/minute; a quiz request can need ~4k, so give the
# worker enough attempts to wait out the rolling window after topic extraction.
GROQ_QUIZ_RETRIES=5

# Limits
MAX_UPLOAD_MB=50
MAX_FILES_PER_BATCH=20
MAX_PDF_PAGES=1000
ASSISTANT_QUERIES_PER_HOUR=20
CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=90

# Storage (Phase 2+)
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
S3_BUCKET=
S3_REGION=
